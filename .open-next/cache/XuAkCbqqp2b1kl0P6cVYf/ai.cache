{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/ai/layout,_N_T_/ai/page,_N_T_/ai"},"segmentPaths":["/_tree","/_full","/ai/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3up8uzl2ek0hf.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2mmpezlrfmbu5.js\" async=\"\"></script><script src=\"/_next/static/chunks/27t_qfc-3_lzs.js\" async=\"\"></script><script src=\"/_next/static/chunks/2e_lrwr-bf1eq.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-17_pvygprndfa.js\" async=\"\"></script><script src=\"/_next/static/chunks/0q_c-6h3ru6s9.js\" async=\"\"></script><script src=\"/_next/static/chunks/32l2-crru5dff.js\" async=\"\"></script><title>Cook Out AI Assistant | Cook Out Menu</title><meta name=\"description\" content=\"Ask the Cook Out Menu AI assistant about menu items, nutrition, prices, trays, shakes, locations and site information.\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://cookout-menu-platform.syedahtishamshahg.workers.dev\"/><meta property=\"og:title\" content=\"Cook Out Menu &amp; Prices\"/><meta property=\"og:description\" content=\"Independent Cook Out menu, nutrition, locations and tools.\"/><meta property=\"og:url\" content=\"https://cookout-menu-platform.syedahtishamshahg.workers.dev\"/><meta property=\"og:site_name\" content=\"Cook Out Menu\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Cook Out Menu &amp; Prices\"/><meta name=\"twitter:description\" content=\"Independent Cook Out menu and nutrition resource.\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><main class=\"ai-page\"><section class=\"ai-hero\"><div class=\"container ai-hero-grid\"><div><div class=\"eyebrow\"><span class=\"live-dot\"></span> Cook Out Intelligence</div><h1>Ask the site.<br/><span>Get a useful answer.</span></h1><p>One assistant for menu discovery, nutrition, meal planning, pricing guidance, shake ideas, locations and everything else we publish.</p><div class=\"ai-capabilities\"><span>Menu</span><span>Nutrition</span><span>Prices</span><span>Trays</span><span>Shakes</span><span>Locations</span></div><a class=\"btn btn-dark\" href=\"#ai-chat-anchor\">Start asking →</a></div><div class=\"ai-hero-art\"><div class=\"ai-orbit-large\"></div><div class=\"ai-core\">✦</div><div class=\"ai-float ai-float-one\">“High protein?”</div><div class=\"ai-float ai-float-two\">“Build my tray”</div><div class=\"ai-float ai-float-three\">“Calories?”</div></div></div></section><section class=\"ai-workbench\" id=\"ai-chat-anchor\"><div class=\"container\"><div class=\"ai-workbench-head\"><span class=\"kicker\">AI WORKBENCH</span><h2>Ask naturally. Explore deeper.</h2><p>The assistant uses our published menu and nutrition database and is designed not to invent missing facts.</p></div><div class=\"ai-embed\"><aside class=\"ai-panel ai-panel-embedded\" aria-label=\"Cook Out Assistant\"><div class=\"ai-panel-head\"><div class=\"ai-brand\"><span class=\"ai-orb\">✦</span><div><strong>Cook Out Assistant</strong><small><span class=\"ai-status-dot\"></span> Smart assistant · source-aware</small></div></div><div class=\"ai-head-actions\"><button type=\"button\" aria-label=\"Clear chat\" title=\"Clear chat\">↻</button></div></div><div class=\"ai-chat-intro\"><div class=\"ai-intro-badge\">AI</div><div><strong>What can I help you with?</strong><span>Ask naturally — no special commands needed.</span></div></div><div class=\"ai-messages\"><div class=\"ai-message-row assistant\"><span class=\"ai-avatar\">✦</span><div class=\"ai-message assistant\">Hi! 👋 I’m Cook Out Assistant. Ask me anything about the menu, nutrition, prices, trays, shakes, locations or this website. I’ll give you a useful answer and clearly flag information that still needs verification.</div></div><div></div></div><div class=\"ai-starters\"><div class=\"ai-starters-label\">Try asking</div><div class=\"ai-starters-row\"><button type=\"button\">What can I order at Cook Out?</button><button type=\"button\">How many calories are in the Huge Hamburger?</button><button type=\"button\">Build me a high-protein tray</button><button type=\"button\">Explain Cook Out prices and why they vary</button></div></div><form class=\"ai-input\"><input placeholder=\"Ask anything about Cook Out…\" aria-label=\"Ask Cook Out Assistant\" value=\"\"/><button type=\"submit\" disabled=\"\" aria-label=\"Send question\">↑</button></form><div class=\"ai-disclaimer\">Independent &amp; unofficial · AI may make mistakes · Verify important restaurant details</div></aside></div></div></section></main><!--$--><!--/$--><button type=\"button\" class=\"theme-toggle\" aria-label=\"Switch to dark theme\" title=\"Dark mode\"><span aria-hidden=\"true\">☾</span></button><button type=\"button\" class=\"ai-launcher \" aria-label=\"Open Cook Out Assistant\"><span class=\"ai-launcher-icon\">✦</span><span><b>Ask Assistant</b><small>Powerful menu &amp; meal assistant</small></span></button><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/0q_c-6h3ru6s9.js\\\"],\\\"default\\\"]\\n3:I[58298,[\\\"/_next/static/chunks/0q_c-6h3ru6s9.js\\\",\\\"/_next/static/chunks/32l2-c